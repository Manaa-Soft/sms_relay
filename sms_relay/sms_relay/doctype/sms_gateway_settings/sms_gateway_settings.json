{
 "name": "SMS Gateway Settings",
 "module": "SMS Relay",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "issingle": 1,
 "istable": 0,
 "editable_grid": 0,
 "track_changes": 0,
 "autoname": "format:SMS Gateway Settings",
 "title_field": "",
 "search_fields": "",
 "sort_field": "creation",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "general_section",
   "fieldtype": "Section Break",
   "label": "Gateway"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled",
   "default": 1
  },
  {
   "fieldname": "gateway_url",
   "fieldtype": "Data",
   "label": "Server URL",
   "reqd": 1,
   "description": "e.g. http://192.168.1.15:8085"
  },
   {
    "fieldname": "api_path",
    "fieldtype": "Data",
    "label": "API Path",
    "default": "/api/3rdparty/v1/message"
   },
    {
     "fieldname": "column_break_general1",
     "fieldtype": "Column Break"
    },
  {
   "fieldname": "timeout",
   "fieldtype": "Int",
   "label": "Timeout (seconds)",
   "default": 15
  },
  {
   "fieldname": "max_retry_count",
   "fieldtype": "Int",
   "label": "Max Retry Count",
   "default": 3
  },
  {
   "fieldname": "section_break_routing",
   "fieldtype": "Section Break",
   "label": "Routing & Rate Limiting"
  },
  {
   "fieldname": "routing_strategy",
   "fieldtype": "Select",
   "label": "Routing Strategy",
   "options": "Round Robin\nPriority\nRandom",
   "default": "Round Robin"
  },
  {
   "fieldname": "failover_enabled",
   "fieldtype": "Check",
   "label": "Enable Failover",
   "default": 1
  },
  {
   "fieldname": "column_break_routing",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "global_rate_limit",
   "fieldtype": "Int",
   "label": "Global Rate Limit (per minute)",
   "default": 60
  },
   {
    "fieldname": "send_interval_min",
    "fieldtype": "Int",
    "label": "Send Interval Min (seconds)",
    "default": 0,
    "description": "Minimum random delay between sends in seconds. 0 = no delay."
   },
   {
    "fieldname": "send_interval_max",
    "fieldtype": "Int",
    "label": "Send Interval Max (seconds)",
    "default": 0,
    "description": "Maximum random delay between sends in seconds. 0 = no delay."
   },
   {
    "fieldname": "rate_limit_period",
    "fieldtype": "Select",
    "label": "Rate Limit Period",
    "options": "Per Minute\nPer Hour\nPer Day",
    "default": "Per Minute",
    "description": "Period for per-device rate limiting."
   },
   {
    "fieldname": "per_device_rate_limit",
    "fieldtype": "Int",
    "label": "Per-Device Rate Limit",
    "default": 0,
    "description": "Max SMS per period per device. 0 = use global limit."
   },
   {
    "fieldname": "device_active_within",
    "fieldtype": "Int",
    "label": "Device Active Within (hours)",
    "default": 24,
    "description": "Only route to devices active within this many hours. 0 = any device."
   },
   {
    "fieldname": "webhook_max_retries",
    "fieldtype": "Int",
    "label": "Webhook Max Retries",
    "default": 15,
    "description": "Max retry attempts for failed webhook deliveries."
   },
   {
    "fieldname": "webhook_base_delay",
    "fieldtype": "Int",
    "label": "Webhook Base Delay (seconds)",
    "default": 30,
    "description": "Base delay for webhook exponential backoff."
   },
   {
    "fieldname": "check_opt_out",
    "fieldtype": "Check",
    "label": "Check Opt-Out List Before Sending",
    "default": 1
   },
  {
   "fieldname": "section_webhook",
   "fieldtype": "Section Break",
   "label": "Webhook (Incoming SMS)"
  },
  {
   "fieldname": "webhook_enabled",
   "fieldtype": "Check",
   "label": "Enable Incoming Webhooks"
  },
   {
    "fieldname": "webhook_secret",
    "fieldtype": "Password",
    "label": "Webhook HMAC Secret"
   },
   {
    "fieldname": "section_gateway_client",
    "fieldtype": "Section Break",
    "label": "Gateway Client & Sync"
   },
   {
    "fieldname": "webhook_url",
    "fieldtype": "Data",
    "label": "Webhook URL",
    "options": "URL",
    "description": "Public URL the gateway POSTs webhooks to. Leave empty to auto-detect the site's webhook endpoint."
   },
   {
    "fieldname": "use_jwt_auth",
    "fieldtype": "Check",
    "label": "Use JWT Authentication",
    "description": "Issue scoped JWT tokens via /auth/token instead of Basic auth. Falls back to Basic if unavailable."
   },
   {
    "fieldname": "column_break_gateway_client",
    "fieldtype": "Column Break"
   },
   {
    "fieldname": "jwt_ttl",
    "fieldtype": "Int",
    "label": "JWT Token TTL (seconds)",
    "default": 3600
   },
   {
    "fieldname": "inbox_sync_enabled",
    "fieldtype": "Check",
    "label": "Enable Inbox Sync",
    "description": "Hourly backfill of the device inbox into SMS Queue (Received)."
   },
   {
    "fieldname": "status_sync_enabled",
    "fieldtype": "Check",
    "label": "Enable Delivery Status Sync",
    "default": 1,
    "description": "Reconcile delivery status of sent messages via the gateway when webhook reports are missing."
   },
   {
    "fieldname": "status_sync_age_minutes",
    "fieldtype": "Int",
    "label": "Status Sync Age (minutes)",
    "default": 30,
    "description": "Only poll messages sent more than this many minutes ago."
   }
  ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "email": 0,
   "print": 0,
   "report": 0,
   "export": 0,
   "import": 0,
   "share": 0
  }
 ]
}
