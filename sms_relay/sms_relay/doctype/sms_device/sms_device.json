{
 "name": "SMS Device",
 "module": "SMS Relay",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "issingle": 0,
 "istable": 0,
 "editable_grid": 0,
 "track_changes": 1,
 "autoname": "field:device_name",
 "title_field": "device_name",
 "search_fields": "device_name,device_id",
 "sort_field": "creation",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "device_name",
   "fieldtype": "Data",
   "label": "Device Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "device_id",
   "fieldtype": "Data",
   "label": "Device ID",
   "description": "Gateway device ID (auto-detected)",
   "in_list_view": 1
  },
  {
   "fieldname": "mode",
   "fieldtype": "Select",
   "label": "Connection Mode",
   "options": "Local\nCloud\nPrivate",
   "default": "Private"
  },
  {
   "fieldname": "server_url",
   "fieldtype": "Data",
   "label": "Server URL",
   "description": "Override per-device (leave empty to use global)"
  },
  {
   "fieldname": "column_break_basic",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "username",
   "fieldtype": "Data",
   "label": "Username"
  },
  {
   "fieldname": "password",
   "fieldtype": "Password",
   "label": "Password"
  },
  {
   "fieldname": "sim_number",
   "fieldtype": "Int",
   "label": "SIM Number",
   "default": "1",
   "options": "1\n2"
  },
  {
   "fieldname": "priority",
   "fieldtype": "Int",
   "label": "Priority",
   "default": 0,
   "description": "Lower = higher priority",
   "in_list_view": 1
  },
  {
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Active",
   "default": 1,
   "in_list_view": 1
  },
   {
    "fieldname": "section_status",
    "fieldtype": "Section Break",
    "label": "Connection Status"
   },
   {
    "fieldname": "is_online",
    "fieldtype": "Check",
    "label": "Online",
    "read_only": 1
   },
   {
    "fieldname": "last_heartbeat",
    "fieldtype": "Datetime",
    "label": "Last Connected",
    "read_only": 1
   },
   {
    "fieldname": "device_model",
    "fieldtype": "Data",
    "label": "Device Model",
    "read_only": 1
   },
   {
    "fieldname": "app_version",
    "fieldtype": "Data",
    "label": "App Version",
    "read_only": 1
   },
   {
    "fieldname": "column_break_status",
    "fieldtype": "Column Break"
   },
   {
    "fieldname": "battery_level",
    "fieldtype": "Int",
    "label": "Battery (%)",
    "read_only": 1
   },
   {
    "fieldname": "signal_strength",
    "fieldtype": "Data",
    "label": "Signal",
    "read_only": 1
   },
   {
    "fieldname": "carrier_name",
    "fieldtype": "Data",
    "label": "Carrier",
    "read_only": 1
   },
   {
    "fieldname": "sim_phone_number",
    "fieldtype": "Data",
    "label": "SIM Phone Number",
    "read_only": 1
   },
   {
    "fieldname": "section_quota",
    "fieldtype": "Section Break",
    "label": "Quotas"
   },
   {
    "fieldname": "daily_quota",
    "fieldtype": "Int",
    "label": "Daily Quota",
    "default": 200
   },
   {
    "fieldname": "sent_today",
    "fieldtype": "Int",
    "label": "Sent Today",
    "default": 0,
    "read_only": 1
   },
   {
    "fieldname": "column_break_quota_inner",
    "fieldtype": "Column Break"
   },
   {
    "fieldname": "hourly_quota",
    "fieldtype": "Int",
    "label": "Hourly Quota",
    "default": 500
   },
   {
    "fieldname": "section_info",
    "fieldtype": "Section Break",
    "label": "Info"
   },
   {
    "fieldname": "country_code",
    "fieldtype": "Data",
    "label": "Default Country Code",
    "default": "+967"
   },
    {
     "fieldname": "notes",
     "fieldtype": "Small Text",
     "label": "Notes"
    },
    {
     "fieldname": "section_break_quota",
     "fieldtype": "Section Break",
     "label": "Gateway Auth"
    },
    {
     "fieldname": "gateway_type",
     "fieldtype": "Select",
     "label": "Gateway Type",
     "options": "Android SMS Gateway\nCustom HTTP API",
     "default": "Android SMS Gateway"
    },
    {
     "fieldname": "api_key",
     "fieldtype": "Password",
     "label": "API Key"
    },
    {
     "fieldname": "column_break_auth",
     "fieldtype": "Column Break"
    },
     {
      "fieldname": "webhook_callback_url",
      "fieldtype": "Data",
      "label": "Webhook Callback URL",
      "options": "URL"
     },
     {
      "fieldname": "webhook_registrations",
      "fieldtype": "Code",
      "label": "Webhook Registrations",
      "options": "JSON",
      "read_only": 1,
      "description": "Gateway webhook ids provisioned for this device (auto-managed)."
     }
   ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "email": 0,
   "print": 0,
   "report": 1,
   "export": 1,
   "import": 1,
   "share": 1
  },
  {
   "role": "All",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "email": 0,
   "print": 0,
   "report": 0,
   "export": 0,
   "import": 0,
   "share": 0
  }
 ]
}
