{
 "name": "SMS Notification",
 "module": "SMS Relay",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "autoname": "field:notification_name",
 "fields": [
  {
   "fieldname": "notification_name",
   "fieldtype": "Data",
   "label": "Notification Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "notification_type",
   "fieldtype": "Select",
   "label": "Notification Type",
   "options": "DocType Event\nScheduler Event",
   "reqd": 1,
   "default": "DocType Event",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "reference_doctype",
   "fieldtype": "Link",
   "label": "Reference DocType",
   "options": "DocType",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "field_name",
   "fieldtype": "Data",
   "label": "Phone Number Field",
   "description": "Field name on the DocType that contains the phone number",
   "mandatory_depends_on": "eval:['DocType Event'].includes(doc.notification_type)"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "disabled",
   "fieldtype": "Check",
   "label": "Disabled",
   "default": 0,
   "in_list_view": 1
  },
  {
   "fieldname": "template",
   "fieldtype": "Link",
   "label": "SMS Template",
   "options": "SMS Template",
   "reqd": 1
  },
  {
   "fieldname": "template_type",
   "fieldtype": "Select",
   "label": "Template Type",
   "options": "Jinja\nParameter",
   "default": "Jinja",
   "reqd": 1,
   "description": "Jinja: use {{ doc.field }} syntax. Parameter: use {{1}}, {{2}} mapped via Fields table below."
  },
  {
   "fieldname": "code",
   "fieldtype": "Code",
   "label": "Preview",
   "read_only": 1
  },
  {
   "fieldname": "section_break_doctype",
   "fieldtype": "Section Break",
   "label": "Document Event",
   "depends_on": "eval:doc.notification_type == 'DocType Event'"
  },
  {
   "fieldname": "doctype_event",
   "fieldtype": "Select",
   "label": "DocType Event",
   "options": "Before Insert\nBefore Validate\nBefore Save\nAfter Insert\nAfter Save\nBefore Submit\nAfter Submit\nBefore Cancel\nAfter Cancel\nBefore Delete\nAfter Delete\nBefore Save (Submitted Document)\nAfter Save (Submitted Document)\nDays After\nDays Before",
   "reqd": 1,
   "default": "After Submit",
   "mandatory_depends_on": "eval:doc.notification_type == 'DocType Event'"
  },
  {
   "fieldname": "column_break_event",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "days_in_advance",
   "fieldtype": "Int",
   "label": "Days Before or After",
   "depends_on": "eval:['Days After','Days Before'].includes(doc.doctype_event)",
   "mandatory_depends_on": "eval:['Days After','Days Before'].includes(doc.doctype_event)"
  },
   {
    "fieldname": "date_changed",
    "fieldtype": "Select",
    "label": "Reference Date",
    "description": "Date field from the DocType to compare against",
    "depends_on": "eval:['Days After','Days Before'].includes(doc.doctype_event)",
    "mandatory_depends_on": "eval:['Days After','Days Before'].includes(doc.doctype_event)"
   },
  {
   "fieldname": "section_break_scheduler",
   "fieldtype": "Section Break",
   "label": "Scheduler Event",
   "depends_on": "eval:doc.notification_type == 'Scheduler Event'"
  },
   {
    "fieldname": "event_frequency",
    "fieldtype": "Select",
    "label": "Event Frequency",
    "options": "All\nHourly\nDaily\nWeekly\nMonthly\nYearly",
    "reqd": 0,
    "depends_on": "eval:doc.notification_type == 'Scheduler Event'",
    "mandatory_depends_on": "eval:doc.notification_type == 'Scheduler Event'"
   },
   {
    "fieldname": "scheduler_data_source",
    "fieldtype": "Select",
    "label": "Scheduler Data Source",
    "options": "\nOverdue Invoices",
    "description": "Overdue Invoices: query submitted Sales Invoices with an outstanding balance past their due date and send one message per invoice.",
    "depends_on": "eval:doc.notification_type == 'Scheduler Event'"
   },
  {
   "fieldname": "section_break_condition",
   "fieldtype": "Section Break",
   "label": "Condition & Message"
  },
  {
   "fieldname": "condition",
   "fieldtype": "Code",
   "label": "Condition (Python Expression)",
   "options": "Python",
   "description": "Return True to send. Example: return doc.grand_total > 1000"
  },
  {
   "fieldname": "column_break_condition",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "message_template",
   "fieldtype": "Code",
   "label": "Message Template (Jinja)",
   "options": "HTML",
   "description": "Use {{ doc }}, {{ frappe.utils.nowdate() }}. Jinja2 syntax."
  },
   {
    "fieldname": "section_break_fields",
    "fieldtype": "Section Break",
    "label": "Fields",
    "depends_on": "eval:doc.template_type == 'Parameter'"
   },
   {
    "fieldname": "fields",
    "fieldtype": "Table",
    "label": "Fields",
    "options": "SMS Message Field",
    "description": "Enter fields in the right sequence as per the template parameters.",
    "depends_on": "eval:doc.template_type == 'Parameter'"
  },
  {
   "fieldname": "property_section",
   "fieldtype": "Section Break",
   "label": "Set Property After Alert"
  },
  {
   "fieldname": "set_property_after_alert",
   "fieldtype": "Select",
   "label": "Set Property After Alert"
  },
  {
   "fieldname": "property_value",
   "fieldtype": "Data",
   "label": "Value To Be Set",
   "depends_on": "eval:doc.set_property_after_alert"
  },
  {
   "fieldname": "help_section",
   "fieldtype": "Section Break",
   "label": "Help"
  },
  {
   "fieldname": "help_html",
   "fieldtype": "HTML",
   "label": "Help",
   "options": "<h4>SMS Notification</h4>\n<p>Triggered automatically when a document event occurs or on a schedule.</p>\n<h5>DocType Event</h5>\n<p>Set <b>Phone Number Field</b> to the fieldname containing the phone number (e.g. <code>mobile_no</code>).</p>\n<p><b>Condition</b> is evaluated as a Python expression. Use <code>doc</code> to access the document.</p>\n<h5>Scheduler Event</h5>\n<p>Set <b>Scheduler Data Source</b> to <code>Overdue Invoices</code> to send one message per overdue Sales Invoice (submitted, outstanding balance past due date). The template is chosen per recipient from the invoice or Customer language.</p>\n<p>Alternatively, in the Condition field set <code>doc.set('_contact_list', ['919123456789'])</code> or <code>doc.set('_data_list', [{'name': 'INV-001', 'phone_no': '919123456789'}])</code></p>\n<h5>Template</h5>\n<p>Link to an SMS Template for pre-approved messages, or write a Jinja template in the Message Template field.</p>"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "delete": 1,
   "create": 1
  },
  {
   "role": "SMS Manager",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ],
 "sort_field": "creation",
 "sort_order": "DESC",
 "title_field": "notification_name"
}
