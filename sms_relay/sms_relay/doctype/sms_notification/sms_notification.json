{
 "name": "SMS Notification",
 "module": "SMS Relay",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "is_submittable": 0,
 "istable": 0,
 "editable_grid": 1,
 "track_changes": 1,
 "autoname": "field:notification_name",
 "fields": [
  {
   "fieldname": "notification_name",
   "fieldtype": "Data",
   "label": "Notification Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "disabled",
   "fieldtype": "Check",
   "label": "Disabled",
   "default": 0,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_main",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "notification_type",
   "fieldtype": "Select",
   "label": "Notification Type",
   "options": "DocType Event\nScheduler Event",
   "reqd": 1,
   "default": "DocType Event",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "section_break_doctype",
   "fieldtype": "Section Break",
   "label": "Document Event"
  },
  {
   "fieldname": "reference_doctype",
   "fieldtype": "Link",
   "label": "Reference DocType",
   "options": "DocType",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "field_name",
   "fieldtype": "Data",
   "label": "Phone Number Field",
   "description": "Field name on the DocType that contains the phone number",
   "mandatory_depends_on": "eval:doc.notification_type == 'DocType Event'"
  },
  {
   "fieldname": "column_break_event",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "doctype_event",
   "fieldtype": "Select",
   "label": "DocType Event",
   "options": "Before Insert\nAfter Insert\nSave\nSubmit\nCancel\nTrash\nAfter Save\nBefore Save\nModified\nValue Changed\nScheduled Task\nBooking Created\nAuthorization",
   "reqd": 1,
   "default": "Submit",
   "mandatory_depends_on": "eval:doc.notification_type == 'DocType Event'"
  },
  {
   "fieldname": "section_break_scheduler",
   "fieldtype": "Section Break",
   "label": "Scheduler Event",
   "depends_on": "eval:doc.notification_type == 'Scheduler Event'"
  },
  {
   "fieldname": "event_frequency",
   "fieldtype": "Select",
   "label": "Frequency",
   "options": "All\nHourly\nDaily\nWeekly\nMonthly\nYearly",
   "reqd": 0,
   "depends_on": "eval:doc.notification_type == 'Scheduler Event'"
  },
  {
   "fieldname": "column_break_sched",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "send_on",
   "fieldtype": "Datetime",
   "label": "Send On",
   "description": "Send at this time (for Scheduler Event)",
   "depends_on": "eval:doc.notification_type == 'Scheduler Event'"
  },
  {
   "fieldname": "section_break_condition",
   "fieldtype": "Section Break",
   "label": "Condition & Template"
  },
  {
   "fieldname": "template",
   "fieldtype": "Link",
   "label": "SMS Template",
   "options": "SMS Template"
  },
  {
   "fieldname": "condition",
   "fieldtype": "Code",
   "label": "Condition (Python Expression)",
   "options": "Python",
   "description": "Return True to send. Example: return doc.grand_total > 1000"
  },
  {
   "fieldname": "column_break_template",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "message_template",
   "fieldtype": "Code",
   "label": "Message Template (Jinja / HTML)",
   "options": "HTML",
   "reqd": 1,
   "description": "Use {{ doc }}, {{ frappe.utils.nowdate() }}. If Template is set, this is auto-generated."
  },
  {
   "fieldname": "section_break_fields",
   "fieldtype": "Section Break",
   "label": "Custom Fields"
  },
  {
   "fieldname": "fields",
   "fieldtype": "Table",
   "label": "Fields",
   "options": "SMS Message Field"
  },
  {
   "fieldname": "section_break_after",
   "fieldtype": "Section Break",
   "label": "After Alert"
  },
  {
   "fieldname": "set_property_after_alert",
   "fieldtype": "Select",
   "label": "Set Property After Alert",
   "options": "None\nDocType Field"
  },
  {
   "fieldname": "property_name",
   "fieldtype": "Data",
   "label": "Property Name",
   "depends_on": "eval:doc.set_property_after_alert == 'DocType Field'"
  },
  {
   "fieldname": "property_value",
   "fieldtype": "Data",
   "label": "Property Value",
   "depends_on": "eval:doc.set_property_after_alert == 'DocType Field'"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "delete": 1,
   "create": 1
  },
  {
   "role": "SMS Manager",
   "read": 1,
   "write": 1,
   "create": 1
  }
 ],
 "sort_field": "creation",
 "sort_order": "DESC",
 "title_field": "notification_name"
}
