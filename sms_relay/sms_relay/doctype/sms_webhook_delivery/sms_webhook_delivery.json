{
 "name": "SMS Webhook Delivery",
 "module": "SMS Relay",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "is_submittable": 0,
 "istable": 0,
 "read_only": 1,
 "autoname": "format:WH-{####}",
 "title_field": "url",
 "search_fields": "url,status",
 "sort_field": "next_retry_at",
 "sort_order": "ASC",
 "fields": [
  {"fieldname": "url", "fieldtype": "Data", "label": "Webhook URL", "reqd": 1, "options": "URL", "in_list_view": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Pending\nSending\nSent\nFailed\nCancelled", "default": "Pending", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "attempts", "fieldtype": "Int", "label": "Attempts", "default": 0, "in_list_view": 1},
  {"fieldname": "max_attempts", "fieldtype": "Int", "label": "Max Attempts", "default": 15},
  {"fieldname": "section_content", "fieldtype": "Section Break", "label": "Content"},
  {"fieldname": "payload", "fieldtype": "Code", "label": "Payload", "options": "JSON", "reqd": 1},
  {"fieldname": "headers", "fieldtype": "Code", "label": "Headers", "options": "JSON"},
  {"fieldname": "column_break_content", "fieldtype": "Column Break"},
  {"fieldname": "response_code", "fieldtype": "Int", "label": "Response Code", "read_only": 1},
  {"fieldname": "response_body", "fieldtype": "Long Text", "label": "Response Body", "read_only": 1},
  {"fieldname": "section_retry", "fieldtype": "Section Break", "label": "Retry", "collapsible": 1},
  {"fieldname": "next_retry_at", "fieldtype": "Datetime", "label": "Next Retry At", "in_list_view": 1},
  {"fieldname": "last_retry_at", "fieldtype": "Datetime", "label": "Last Retry At", "read_only": 1},
  {"fieldname": "column_break_retry", "fieldtype": "Column Break"},
  {"fieldname": "base_delay", "fieldtype": "Int", "label": "Base Delay (sec)", "default": 30, "description": "Exponential backoff base delay in seconds"},
  {"fieldname": "error_message", "fieldtype": "Long Text", "label": "Last Error"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "delete": 1},
  {"role": "SMS Manager", "read": 1, "write": 1}
 ],
 "sort_field": "next_retry_at",
 "sort_order": "ASC"
}
