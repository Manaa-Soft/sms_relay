{
 "name": "SMS Outbox",
 "module": "SMS Relay",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "is_submittable": 0,
 "istable": 0,
 "read_only": 1,
 "autoname": "format:OUTBOX-{####}",
 "fields": [
  {"fieldname": "sms_queue", "fieldtype": "Link", "label": "SMS Queue", "options": "SMS Queue", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "channel", "fieldtype": "Select", "label": "Channel", "options": "SMS", "default": "SMS", "in_list_view": 1},
  {"fieldname": "account", "fieldtype": "Link", "label": "Account", "options": "SMS Device", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Pending\nSending\nSent\nFailed", "default": "Pending", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "attempts", "fieldtype": "Int", "label": "Attempts", "default": 0, "in_list_view": 1},
  {"fieldname": "max_attempts", "fieldtype": "Int", "label": "Max Attempts", "default": 5},
  {"fieldname": "section_break_retry", "fieldtype": "Section Break", "label": "Retry"},
  {"fieldname": "next_retry_at", "fieldtype": "Datetime", "label": "Next Retry At", "in_list_view": 1},
  {"fieldname": "last_retry_at", "fieldtype": "Datetime", "label": "Last Retry At", "read_only": 1},
  {"fieldname": "column_break_retry", "fieldtype": "Column Break"},
  {"fieldname": "error_message", "fieldtype": "Long Text", "label": "Last Error"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "delete": 1},
  {"role": "SMS Manager", "read": 1, "write": 1}
 ],
