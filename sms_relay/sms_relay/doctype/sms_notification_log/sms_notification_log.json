{
 "name": "SMS Notification Log",
 "module": "SMS Relay",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "is_submittable": 0,
 "istable": 0,
 "read_only": 1,
 "autoname": "format:RLOG-{####}",
 "fields": [
  {"fieldname": "notification", "fieldtype": "Link", "label": "Notification", "options": "SMS Notification", "read_only": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "reference_doctype", "fieldtype": "Data", "label": "Document Type", "read_only": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "reference_name", "fieldtype": "Data", "label": "Document Name", "read_only": 1, "in_list_view": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "phone", "fieldtype": "Data", "label": "Phone", "read_only": 1, "in_list_view": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Sent\nFailed", "read_only": 1, "in_list_view": 1},
  {"fieldname": "sent_at", "fieldtype": "Datetime", "label": "Sent At", "read_only": 1},
  {"fieldname": "section_break_message", "fieldtype": "Section Break", "label": "Message"},
  {"fieldname": "message", "fieldtype": "Long Text", "label": "Message", "read_only": 1},
  {"fieldname": "column_break_err", "fieldtype": "Column Break"},
  {"fieldname": "error", "fieldtype": "Small Text", "label": "Error", "read_only": 1, "depends_on": "eval:doc.status=='Failed'"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1},
  {"role": "SMS Manager", "read": 1},
  {"role": "SMS Operator", "read": 1}
 ],
 "sort_field": "creation",
 "sort_order": "DESC"
}