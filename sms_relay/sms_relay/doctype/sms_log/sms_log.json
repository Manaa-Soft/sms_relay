{
 "name": "SMS Log",
 "module": "SMS Relay",
 "doctype": "DocType",
 "document_type": "Document",
 "engine": "InnoDB",
 "issingle": 0,
 "istable": 0,
 "editable_grid": 0,
 "track_changes": 0,
 "read_only": 1,
 "autoname": "format:SMS-{####}",
 "title_field": "phone",
 "search_fields": "phone,recipient_name,gateway_message_id",
 "sort_field": "creation",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "phone",
   "fieldtype": "Data",
   "label": "Phone Number",
   "reqd": 1,
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "recipient_name",
   "fieldtype": "Data",
   "label": "Recipient",
   "read_only": 1
  },
  {
   "fieldname": "message",
   "fieldtype": "Long Text",
   "label": "Message",
   "read_only": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
    "options": "Pending\nQueued\nSending\nSent\nDelivered\nFailed\nRetrying\nCancelled",
   "default": "Queued",
   "read_only": 1,
   "in_list_view": 1
  },
   {
    "fieldname": "delivery_status",
    "fieldtype": "Select",
    "label": "Delivery Status",
    "options": "Pending\nSent\nDelivered\nFailed\nExpired",
    "default": "Pending",
    "read_only": 1,
    "in_list_view": 1,
    "in_standard_filter": 1
   },
   {
    "fieldname": "delivery_at",
    "fieldtype": "Datetime",
    "label": "Delivery Report Time"
   },
   {
    "fieldname": "column_break_del",
    "fieldtype": "Column Break"
   },
   {
    "fieldname": "channel",
    "fieldtype": "Data",
    "label": "Channel",
    "default": "SMS"
   },
  {
   "fieldname": "section_source",
   "fieldtype": "Section Break",
   "label": "Source"
  },
  {
   "fieldname": "reference_doctype",
   "fieldtype": "Link",
   "label": "DocType",
   "options": "DocType",
   "read_only": 1
  },
  {
   "fieldname": "reference_name",
   "fieldtype": "Data",
   "label": "Document",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section_gateway",
   "fieldtype": "Section Break",
   "label": "Gateway Info"
  },
   {
    "fieldname": "gateway_message_id",
    "fieldtype": "Data",
    "label": "Gateway Message ID",
    "read_only": 1
   },
   {
    "fieldname": "sms_parts",
    "fieldtype": "Int",
    "label": "SMS Parts",
    "read_only": 1,
    "description": "Actual multipart segment count reported by the gateway (sms:sent)"
   },
  {
   "fieldname": "device",
   "fieldtype": "Link",
   "label": "Device",
   "options": "SMS Device",
   "read_only": 1
  },
   {
    "fieldname": "sim_number",
    "fieldtype": "Int",
    "label": "SIM",
    "read_only": 1
   },
   {
    "fieldname": "device_id",
    "fieldtype": "Data",
    "label": "Device ID",
    "read_only": 1
   },
   {
    "fieldname": "message_id",
    "fieldtype": "Data",
    "label": "Message ID",
    "read_only": 1,
    "description": "Client-supplied ID for idempotency"
   },
  {
   "fieldname": "section_timing",
   "fieldtype": "Section Break",
   "label": "Timing"
  },
  {
   "fieldname": "queued_at",
   "fieldtype": "Datetime",
   "label": "Queued At",
   "read_only": 1
  },
  {
   "fieldname": "sent_at",
   "fieldtype": "Datetime",
   "label": "Sent At",
   "read_only": 1
  },
   {
    "fieldname": "delivered_at",
    "fieldtype": "Datetime",
    "label": "Delivered At",
    "read_only": 1
   },
   {
    "fieldname": "cancelled_at",
    "fieldtype": "Datetime",
    "label": "Cancelled At",
    "read_only": 1
   },
  {
   "fieldname": "section_debug",
   "fieldtype": "Section Break",
   "label": "Debug",
   "collapsible": 1
  },
  {
   "fieldname": "retry_count",
   "fieldtype": "Int",
   "label": "Retries",
   "read_only": 1
  },
  {
   "fieldname": "error_message",
   "fieldtype": "Long Text",
   "label": "Error",
   "read_only": 1
  },
  {
   "fieldname": "webhook_payload",
   "fieldtype": "Code",
   "label": "Webhook Payload",
   "options": "JSON",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 1,
   "email": 0,
   "print": 1,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 0
  },
  {
   "role": "All",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "email": 0,
   "print": 0,
   "report": 0,
   "export": 0,
   "import": 0,
   "share": 0
  }
 ]
}
